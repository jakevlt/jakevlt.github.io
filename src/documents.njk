---
layout: layouts/base.njk
titre: Documents
description: "Documents de Jake Volante à télécharger : CV, rapports de stage (La Banque Postale, Fonroche Lighting), tableau de synthèse et attestations."
permalink: /documents/
---
{%- from "partials/icones.njk" import icone -%}
<div class="container container--narrow">
  <header class="page-header">
    <p class="eyebrow">Téléchargements</p>
    <h1>Documents</h1>
    <p class="lead">Les documents qui accompagnent mon portfolio, au format PDF.</p>
  </header>

  <section aria-labelledby="titre-candidature" class="bloc-docs">
    <h2 id="titre-candidature">Candidature</h2>
    <ul class="docs-list">
      <li>
        {%- if site.cv %}
        <a class="doc-link" href="{{ site.cv }}" type="application/pdf">{{ icone("file") | safe }}<span>Curriculum vitae<small>PDF</small></span></a>
        {%- else %}
        <p class="doc-link">{{ icone("file") | safe }}<span>Curriculum vitae <small>{% todo "CV mis à jour, sans adresse ni téléphone" %}</small></span></p>
        {%- endif %}
      </li>
    </ul>
  </section>

  <section aria-labelledby="titre-bts" class="bloc-docs">
    <h2 id="titre-bts">BTS SIO</h2>
    <ul class="docs-list">
      <li><a class="doc-link" href="/documents/tableau-de-synthese-jake-volante.pdf" type="application/pdf">{{ icone("file") | safe }}<span>Tableau de synthèse des réalisations<small>PDF, version imprimable du tableau en ligne</small></span></a></li>
      {%- for stage in stages %}
      <li><a class="doc-link" href="{{ stage.rapport.url }}" type="application/pdf">{{ icone("file") | safe }}<span>Rapport de stage, {{ stage.entreprise }} ({{ stage.periodeTexte | lower }})<small>{{ stage.rapport.info }}</small></span></a></li>
      {%- endfor %}
    </ul>
  </section>

  <section aria-labelledby="titre-attestations" class="bloc-docs">
    <h2 id="titre-attestations">Attestations et certifications</h2>
    <ul class="docs-list">
      <li><p class="doc-link">{{ icone("file") | safe }}<span>Certification PIX (2024)<small>{% todo "attestation PIX en PDF" %}</small></span></p></li>
      <li><p class="doc-link">{{ icone("file") | safe }}<span>PSE 1, premiers secours en équipe (2024)<small>{% todo "attestation PSE 1 en PDF (facultatif)" %}</small></span></p></li>
      <li><p class="doc-link">{{ icone("file") | safe }}<span>Attestations de stage<small>{% todo "attestations de fin de stage (facultatif)" %}</small></span></p></li>
    </ul>
  </section>
</div>
